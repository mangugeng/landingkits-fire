rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fungsi untuk memvalidasi user
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Fungsi untuk memvalidasi user adalah pengirim atau penerima
    function isSenderOrReceiver(userId) {
      return isAuthenticated() && 
        (request.auth.uid == userId || 
         request.auth.uid == resource.data.senderId || 
         request.auth.uid == resource.data.receiverId);
    }

    // Fungsi untuk memvalidasi tipe pesan
    function isValidMessageType() {
      return request.resource.data.type in ['text', 'image', 'file'];
    }

    // Fungsi untuk memvalidasi file
    function isValidFile() {
      return request.resource.data.type == 'text' || 
        (request.resource.data.type in ['image', 'file'] && 
         request.resource.data.fileUrl is string &&
         request.resource.data.fileName is string &&
         request.resource.data.fileSize is number &&
         request.resource.data.fileSize <= 10 * 1024 * 1024); // Max 10MB
    }

    // Rules untuk koleksi messages
    match /messages/{messageId} {
      // Membaca pesan
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.senderId || 
         request.auth.uid == resource.data.receiverId);
      
      // Membuat pesan baru
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.senderId &&
        request.resource.data.timestamp is timestamp &&
        request.resource.data.isRead == false &&
        isValidMessageType() &&
        isValidFile() &&
        (request.resource.data.type == 'text' || 
         (request.resource.data.type in ['image', 'file'] && 
          request.resource.data.fileUrl != null));
      
      // Mengupdate pesan (hanya untuk mark as read)
      allow update: if isAuthenticated() && 
        (request.auth.uid == resource.data.senderId || 
         request.auth.uid == resource.data.receiverId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead']) &&
        request.resource.data.isRead == true;
      
      // Menghapus pesan
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.senderId;

      // Rules untuk subcollection replies
      match /replies/{replyId} {
        allow read: if isAuthenticated() && 
          (request.auth.uid == resource.data.senderId || 
           request.auth.uid == resource.data.receiverId);
        
        allow create: if isAuthenticated() && 
          request.auth.uid == request.resource.data.senderId &&
          request.resource.data.timestamp is timestamp &&
          request.resource.data.isRead == false &&
          isValidMessageType() &&
          isValidFile();
        
        allow update: if isAuthenticated() && 
          (request.auth.uid == resource.data.senderId || 
           request.auth.uid == resource.data.receiverId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead']) &&
          request.resource.data.isRead == true;
        
        allow delete: if isAuthenticated() && 
          request.auth.uid == resource.data.senderId;
      }
    }

    // Rules untuk koleksi conversations
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid in resource.data.participants);
      
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() >= 2;
      
      allow update: if isAuthenticated() && 
        request.auth.uid in resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageTime', 'unreadCount']);
      
      allow delete: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
    }
  }
} 