rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Aturan untuk gambar user
    match /users/{userId}/images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Aturan untuk image library
    match /imageLibrary/{imageId} {
      allow read: if true; // Semua user bisa membaca
      allow write: if request.auth != null && request.auth.token.admin == true; // Hanya admin bisa menulis
    }
  }
} 